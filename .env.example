# =====================================================================
#  Shaxsiy Dashboard — server sozlamalari
#
#      cp .env.example .env     va quyidagilarni to'ldiring
#
#  Bu fayl api.py haqiqatan o'qiydigan HAMMA o'zgaruvchini sanaydi.
#  Qavs ichidagi qiymat — sukut bo'yicha, ya'ni yozmasangiz shu bo'ladi.
#
#  Parollar va kalitlarni bu yerga qo'lda yozish shart emas — deploy/
#  ichidagi skriptlar ularni ekranga chiqarmasdan yozadi:
#      ./deploy/set-users.sh     ./deploy/set-register.sh
#      ./deploy/set-google.sh    ./deploy/set-ai.sh
#      ./deploy/set-whoop.sh     ./deploy/set-secret.sh
# =====================================================================

# ── ENG MUHIMI: kim kira oladi ───────────────────────────────────────
#
#  ⚠️  MA_REGISTER sukut bo'yicha OCHIQ. Ya'ni bu qatorni yozmasangiz,
#      saytingizni topgan HAR KIM o'ziga hisob ochadi. Shaxsiy dashboard
#      ochiq IP'da turganda buni ataylab tanlash kerak.
#
#  Uchta holat bor:
#    MA_REGISTER=0                  — yopiq: faqat siz yaratgan hisoblar
#    MA_REGISTER=1 + MA_INVITE=kod  — taklif kodi bilan
#    MA_REGISTER=1                  — hamma uchun ochiq (ehtiyot bo'ling)
MA_REGISTER=0
# Taklif kodi (MA_REGISTER=1 bo'lganda). Bo'sh = kod so'ralmaydi.
MA_INVITE=

# Ism:parol[:uid][:telegram_id] — vergul bilan ajratiladi.
# Mavjud ma'lumot egasiga :me bering. ./deploy/set-users.sh bilan yozing.
MA_USERS=

# Egasining umumiy paroli. MA_USERS yozilgan bo'lsa e'tiborsiz qoladi.
# MA_USERS ham, bu ham bo'sh bo'lsa — ochiq serverda hech kim kira olmaydi.
MA_PASSCODE=

# Sessiya imzo kaliti. set-users.sh bir marta o'zi yozadi.
# ⚠️  O'zgartirsangiz hamma chiqib ketadi (imzo eskiradi).
MA_SECRET=

# Sessiya necha kun yashaydi. (30)
MA_SESSION_DAYS=30

# ── Google bilan kirish (ixtiyoriy) ──────────────────────────────────
# console.cloud.google.com → OAuth mijoz ID. ./deploy/set-google.sh
# Redirect URI (aynan shunday): https://SIZNING-DOMEN/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Ruxsat etilgan emaillar (vergul bilan). Bo'sh = MA_REGISTER/MA_INVITE qoidasi ishlaydi.
MA_ALLOWED_EMAILS=
# Yangi Google hisobidan ham taklif kodi so'ralsinmi. (1)
MA_GOOGLE_INVITE=1

# ── WHOOP (ixtiyoriy) — developer.whoop.com ──────────────────────────
# Redirect URI (aynan shunday):
#   jonli server: https://SIZNING-DOMEN/api/whoop/callback
#   lokal sinov:  https://localhost:8443/api/whoop/callback
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
# Server WHOOP'ni har daqiqada so'rab tursinmi. (1) — 0 qilsangiz faqat qo'lda yangilanadi.
MA_WHOOP_POLL=1
# Ruxsatlar ro'yxati. WHOOP ilovangizda 'offline' yo'q bo'lsa shu qatordan
# uni olib tashlang — u holda token ~1 soat yashaydi va qayta ulash kerak bo'ladi.
# WHOOP_SCOPES=offline read:recovery read:sleep read:cycles read:workout read:profile read:body_measurement

# ── AI (ixtiyoriy) — har sahifadagi maslahat, Nova, ovqat tahlili ────
# Ikkita provayder qo'llanadi. ./deploy/set-ai.sh
#
#   OpenAI uchun:
#     AI_PROVIDER=openai
#     OPENAI_API_KEY=sk-...
#     OPENAI_MODEL=gpt-5                          (gpt-5)
#     OPENAI_REASONING=low                        (low)
#     OPENAI_BASE_URL=https://api.openai.com/v1   (shu)
#
#   Anthropic uchun:
#     AI_PROVIDER=anthropic
#     AI_API_KEY=sk-ant-...      (yoki ANTHROPIC_API_KEY)
#     AI_MODEL=claude-opus-5     (claude-opus-5)
#
# Kalit hech qachon brauzerga chiqmaydi — so'rovni server yuboradi.
#
# Tashqi AI so'rovining eng uzun muddati, soniyada. (60)
# gunicorn --timeout 120 dan ancha past bo'lishi shart.
MA_AI_TIMEOUT=60
# Bitta hisob uchun soatiga nechta AI so'rovi. (80)  0 = cheklovsiz.
# Kalit sizniki — halqaga tushgan sahifa yoki cho'ntakdagi telefon pulni yeb qo'ymasin.
MA_AI_HOURLY=80
AI_PROVIDER=
AI_API_KEY=
# AI_API_KEY bo0sh bo0lsa shu ham qaraladi:
ANTHROPIC_API_KEY=
AI_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_REASONING=
OPENAI_BASE_URL=

# ── Telegram Mini App (ixtiyoriy, eski yo'l) ─────────────────────────
# Brauzer va Google bilan kirish yetarli bo'lsa — bularni bo'sh qoldiring.
# ./deploy/set-telegram.sh
MA_BOT_TOKEN=
# Ruxsat etilgan Telegram ID lar (vergul bilan). Bo'sh = Telegram eshigi yopiq.
MA_ALLOWED_IDS=

# ── Server ───────────────────────────────────────────────────────────
PORT=8081
# Qaysi manzilda tinglaydi. (127.0.0.1) — nginx ortida shundayligicha qoldiring.
HOST=127.0.0.1
# Ma'lumot papkasi. (shu fayl yonidagi data/)
MA_DATA_DIR=
# Statik fayllar papkasi. (shu fayl yonidagi papka)
MA_STATIC_DIR=
# Tashqi so0rovlarda ko0rsatiladigan User-Agent. (ShaxsiyDashboard/1.0 …)
MA_USER_AGENT=

# ── Faqat lokal ishlab chiqish uchun ─────────────────────────────────
#
#  ⚠️  MA_DEV=1 AUTENTIFIKATSIYANI BUTUNLAY O'CHIRADI.
#      Jonli serverda hech qachon 1 qilmang.
MA_DEV=0
# O'z-o'zini imzolagan sertifikat bilan https://localhost — WHOOP lokal sinovi uchun.
MA_HTTPS=0
MA_CERT_DIR=

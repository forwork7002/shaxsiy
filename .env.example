# Shaxsiy Dashboard — server sozlamalari (nusxa: cp .env.example .env)

# Telegram bot tokeni (@BotFather). Mini App autentifikatsiyasi uchun majburiy.
MA_BOT_TOKEN=
# Ruxsat etilgan Telegram ID lar (vergul bilan). Bo'sh qoldirsangiz — hamma kira oladi!
MA_ALLOWED_IDS=
# Lokal test uchun: 1 → auth o'chadi, http://127.0.0.1:8081/?server=1
MA_DEV=0

# HTTPS (WHOOP uchun majburiy). 1 → https://localhost:PORT, o'z-o'zini imzolagan sertifikat bilan.
MA_HTTPS=0

# WHOOP (ixtiyoriy) — developer.whoop.com
# Redirect URI (WHOOP paneliga aynan shuni yozing):
#   lokal sinov:  https://localhost:8443/api/whoop/callback
#   jonli server: https://SIZNING-DOMEN/api/whoop/callback
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
# Agar WHOOP ilovangizda 'offline' ruxsati yo'q bo'lsa, uni ro'yxatdan olib tashlang
# (token ~1 soat yashaydi, keyin qayta ulash kerak):
# WHOOP_SCOPES=read:recovery read:sleep read:cycles read:workout read:profile read:body_measurement

# Nova AI (ixtiyoriy) — console.anthropic.com
AI_API_KEY=
AI_MODEL=claude-opus-5

PORT=8081

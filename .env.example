# Shaxsiy Dashboard — server sozlamalari (nusxa: cp .env.example .env)

# Telegram bot tokeni (@BotFather). Mini App autentifikatsiyasi uchun majburiy.
MA_BOT_TOKEN=
# Ruxsat etilgan Telegram ID lar (vergul bilan). Bo'sh qoldirsangiz — hamma kira oladi!
MA_ALLOWED_IDS=
# Lokal test uchun: 1 → auth o'chadi, http://127.0.0.1:8081/?server=1
MA_DEV=0

# WHOOP (ixtiyoriy) — developer.whoop.com, Redirect URI: https://SIZNING-DOMEN/api/whoop/callback
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# Nova AI (ixtiyoriy) — console.anthropic.com
AI_API_KEY=
AI_MODEL=claude-opus-5

PORT=8081

# =====================================================================
#  Shaxsiy Dashboard — server sozlamalari
#  Nusxa oling:  cp .env.example .env    keyin:  ./start.sh
#
#  Hech biri majburiy emas: bo'sh .env bilan ham ishlaydi (hisob ochish
#  ochiq turadi). Faqat kerakli bo'limni to'ldiring.
# =====================================================================

# ── Asosiy ───────────────────────────────────────────────────────────
PORT=8081
# HOST: gunicorn orqasida 127.0.0.1 qoladi. To'g'ridan-to'g'ri ochish uchun 0.0.0.0.
HOST=127.0.0.1
# MA_DEV=1 → auth o'chadi, http://127.0.0.1:8081/?server=1 (FAQAT lokal sinov)
MA_DEV=0
# MA_HTTPS=1 → o'z-o'zini imzolagan sertifikat bilan https://localhost:PORT
# (jonli serverda kerak emas — nginx + Let's Encrypt HTTPS ni o'zi beradi)
MA_HTTPS=0
# Sessiya cookie imzosi. Bo'sh qoldirsangiz avtomatik yoziladi.
# O'zgartirsangiz hamma foydalanuvchi chiqib ketadi. Skript: deploy/set-secret.sh
MA_SECRET=
# Sessiya necha kun yashaydi
MA_SESSION_DAYS=30

# ── Kim kira oladi ───────────────────────────────────────────────────
# Uch xil eshik bor, birgalikda ishlaydi:
#
#   1) Hisob ochish (default: ochiq). Har kim kirish oynasida o'ziga hisob
#      ochadi, parollar xeshlanib data/users.json ga yoziladi.
#      MA_REGISTER=0 → eshik yopiladi.   Skript: deploy/set-register.sh
MA_REGISTER=1
#      Taklif kodi: bo'sh bo'lmasa, hisob ochish uchun shu kod so'raladi.
MA_INVITE=
#
#   2) Oldindan yozilgan foydalanuvchilar — Ism:parol[:uid]
#      Mavjud ma'lumot egasi uchun uid sifatida :me yozing.
#      Skript (parollar terminalda ko'rinmaydi): deploy/set-users.sh
MA_USERS=
#
#   3) Bitta umumiy parol (eski usul). MA_USERS bo'lsa e'tiborsiz qoladi.
#      Skript: deploy/set-passcode.sh
MA_PASSCODE=

# ── Google bilan kirish (ixtiyoriy) ──────────────────────────────────
# console.cloud.google.com → OAuth 2.0 Client ID (Web application)
# Redirect URI aynan shunday:  https://SIZNING-DOMEN/api/auth/google/callback
# Skript: deploy/set-google.sh
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Faqat shu emaillar kirsin (vergul bilan). Bo'sh = hisob ochish qoidasi amal qiladi.
MA_ALLOWED_EMAILS=
# Yangi Google hisobi ham MA_INVITE kodini so'rasinmi (1 = ha)
MA_GOOGLE_INVITE=1

# ── AI: murabbiy kartalari, Nova chat, ovqat rasm tahlili ────────────
# AI_PROVIDER: openai | anthropic. Bo'sh qoldirilsa qaysi kalit borligiga qarab tanlanadi.
AI_PROVIDER=openai
# OpenAI — platform.openai.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_BASE_URL=https://api.openai.com/v1
# Fikrlash chuqurligi: low | medium | high (qimmatroq va sekinroq)
OPENAI_REASONING=low
# Anthropic — console.anthropic.com (AI_PROVIDER=anthropic bo'lsa)
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
# Eski umumiy nom: AI_PROVIDER ga mos kalit sifatida ham qabul qilinadi
AI_API_KEY=
# Skript (kalit terminalda ko'rinmaydi): deploy/set-ai.sh

# ── WHOOP (ixtiyoriy) ────────────────────────────────────────────────
# developer.whoop.com → ilova yarating
# Redirect URI aynan shunday:  https://SIZNING-DOMEN/api/whoop/callback
# Skript: deploy/set-whoop.sh
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
# Server har daqiqa WHOOP'ni so'rab tursinmi (1 = ha, 0 = faqat qo'lda sinxron)
MA_WHOOP_POLL=1
# Ilovangizda 'offline' ruxsati yo'q bo'lsa, uni ro'yxatdan olib tashlang
# (token ~1 soat yashaydi, keyin qayta ulash kerak):
# WHOOP_SCOPES=read:recovery read:sleep read:cycles read:workout read:profile read:body_measurement

# ── Yo'llar (odatda tegilmaydi) ──────────────────────────────────────
# MA_DATA_DIR=./data        — ma'lumot, zaxira, arxiv, ovqat rasmlari
# MA_STATIC_DIR=.           — index.html va statik fayllar
# MA_CERT_DIR=./certs       — MA_HTTPS=1 uchun sertifikat

# ── Meros: Telegram Mini App ─────────────────────────────────────────
# api.py da initData imzosini tekshirish kodi hali turibdi va ishlaydi,
# lekin index.html telegram-web-app.js ni yuklamaydi — ya'ni hozirgi
# mijozdan bu yo'lga tushib bo'lmaydi. Telegram ichidan kirishni qaytarish
# niyatingiz bo'lmasa, ikkalasini ham bo'sh qoldiring.
MA_BOT_TOKEN=
MA_ALLOWED_IDS=

# ── Ichki ────────────────────────────────────────────────────────────
# Tashqi so'rovlarda (WHOOP, AI, Google) yuboriladigan User-Agent
# MA_USER_AGENT=ShaxsiyDashboard/1.0 (+https://github.com/forwork7002/shaxsiy)
